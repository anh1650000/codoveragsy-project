# Cấu hình chạy script trực tiếp trên máy chủ (host):
POSTGRES_DB=contracts
POSTGRES_USER=contracts
POSTGRES_PASSWORD=contracts
DATABASE_URL=postgresql+asyncpg://contracts:contracts@localhost:5432/contracts
LLM_BASE_URL=http://localhost:11434/v1
API_BASE_URL=http://localhost:8000
UPLOAD_DIR=./data/uploads

# Cấu hình ghi đè khi chạy toàn bộ stack bằng Docker Compose:
DOCKER_DATABASE_URL=postgresql+asyncpg://contracts:contracts@postgres:5432/contracts
# Mặc định gọi Ollama chạy native trên máy chính; nếu chạy `docker compose --profile ollama up`, đổi thành http://ollama:11434/v1
DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
DOCKER_API_BASE_URL=http://api:8000
DOCKER_UPLOAD_DIR=/app/data/uploads

# Tham số LLM, ngưỡng kiểm chứng và đối soát:
LLM_MODEL=frob/qwen3.5-instruct:4b
LLM_API_KEY=ollama
CITATION_THRESHOLD=85
NAME_MATCH_THRESHOLD=90
NAME_SCORE_MARGIN=5.0
MAX_RETRIES=2
ENABLE_VERIFIER=true
ENABLE_RETRY=true
MAX_UPLOAD_MB=10

# Tham số polling cho UI Streamlit và smoke test (tính bằng giây):
UI_POLL_INTERVAL_SECONDS=2
UI_POLL_TIMEOUT_SECONDS=600
SMOKE_TEST_TIMEOUT_SECONDS=600
