# Scripts chạy trên máy chính: Ollama cài trực tiếp, PostgreSQL chạy trong Docker.
DATABASE_URL=postgresql+asyncpg://contracts:contracts@localhost:5432/contracts
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=frob/qwen3.5-instruct:4b
LLM_API_KEY=ollama
CITATION_THRESHOLD=85
NAME_MATCH_THRESHOLD=90
MAX_RETRIES=2
ENABLE_VERIFIER=true
ENABLE_RETRY=true
UPLOAD_DIR=./data/uploads
